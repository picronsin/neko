{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neko.m1k1o.net/schema/websocket.json",
  "title": "Neko WebSocket envelope",
  "description": "The only supported real-time message shape is {event,payload}.",
  "type": "object",
  "required": ["event"],
  "additionalProperties": false,
  "properties": {
    "event": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "system/init", "system/admin", "system/settings", "system/logs", "system/disconnect", "system/heartbeat", "system/error",
        "client/heartbeat",
        "signal/request", "signal/restart", "signal/offer", "signal/answer", "signal/provide", "signal/candidate", "signal/close", "signal/video", "signal/audio",
        "session/created", "session/deleted", "session/profile", "session/state", "session/cursors",
        "control/host", "control/release", "control/request", "control/renew",
        "screen/updated", "screen/set", "clipboard/updated", "clipboard/set",
        "keyboard/modifiers", "keyboard/map", "broadcast/status", "send/unicast", "send/broadcast",
        "file_chooser_dialog/opened", "file_chooser_dialog/closed",
        "chat/init", "chat/message", "chat/emote", "filetransfer/update", "openinapp/init", "openinapp/openlink"
      ]
    },
    "payload": {
      "description": "Payloads are JSON objects or arrays. Events without a payload omit this property.",
      "anyOf": [
        { "type": "object" },
        { "type": "array" }
      ]
    }
  }
}
