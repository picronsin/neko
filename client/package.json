{
  "name": "neko-client",
  "version": "2.5.0",
  "description": "Client for neko streaming server",
  "license": "Apache License 2.0",
  "engines": {
    "node": ">=18"
  },
  "author": "Nurdism <https://github.com/nurdism>",
  "homepage": "https://github.com/m1k1o/neko/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m1k1o/neko.git"
  },
  "bugs": {
    "url": "https://github.com/m1k1o/neko/issues"
  },
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "serve:vite": "vite",
    "build:vite": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "build:lib": "vite build --mode library",
    "build:emoji": "ts-node --files --project tools/tsconfig.json tools/emoji.ts",
    "test:sdk": "ts-node --project tools/tsconfig.json tools/sdk.test.ts",
    "generate:api": "openapi-generator-cli generate -i ../server/openapi.yaml -g typescript-axios -o src/api/generated --additional-properties=supportsES6=true,withSeparateModelsAndApi=true,apiPackage=api,modelPackage=model",
    "lint": "eslint src --ext .ts,.vue"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.2.0",
    "@kyvg/vue3-notification": "3.2.1",
    "@vue/compiler-sfc": "3.5.42",
    "animejs": "^3.2.0",
    "axios": "^1.2.3",
    "date-fns": "^2.29.3",
    "emoji-datasource": "^6.0.1",
    "eventemitter3": "^4.0.7",
    "floating-vue": "5.2.2",
    "pinia": "2.3.1",
    "resize-observer-polyfill": "^1.5.1",
    "simple-markdown": "^0.7.2",
    "sweetalert2": "11.4.8",
    "vue": "3.5.42",
    "vue-facing-decorator": "^3.0.4",
    "vue-i18n": "11.4.10"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@types/animejs": "^3.1.6",
    "@types/node": "^18.11.18",
    "@typescript-eslint/eslint-plugin": "^5.0.8",
    "@typescript-eslint/parser": "^5.0.8",
    "@vitejs/plugin-vue": "5.2.3",
    "core-js": "^3.26.0",
    "emojilib": "^3.0.7",
    "eslint": "^8.32.0",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^2.7.1",
    "sass": "^1.55.0",
    "ts-node": "^9.1.1",
    "typescript": "^5.7.3",
    "vite": "6.4.3",
    "vue-tsc": "2.2.0"
  }
}
